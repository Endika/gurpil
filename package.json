{
  "name": "gurpil",
  "version": "0.11.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src tests --ext .ts --max-warnings 0",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"{src,tests}/**/*.{ts,css}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,css}\"",
    "type:check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "prepare": "husky"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.20.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.8",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
